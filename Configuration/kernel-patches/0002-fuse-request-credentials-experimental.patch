+/* No request pointer escapes pq.lock. A separate cred reference permits
+ * user copies after unlocking, without keeping a completed request findable.
+ * Linearization is the lookup; the daemon must serialize queries and replies.
+ */
+static long fuse_dev_ioctl_request_cred(struct file *file, void __user *argp)
+{
+	struct fuse_dev *fud = fuse_get_dev(file);
+	struct fuse_request_cred out;
+	struct fuse_pqueue *fpq;
+	struct fuse_req *req;
+	const struct cred *cred = NULL;
+	u32 capacity, count, n;
+	u32 *groups = NULL;
+	int err = 0;
+
+	if (IS_ERR(fud))
+		return PTR_ERR(fud);
+	if (file->f_op != &fuse_dev_operations || !fud->fc->request_cred ||
+	    fud->fc->user_ns != &init_user_ns || fud->fc->io_uring)
+		return -EOPNOTSUPP;
+	if (current_user_ns() != &init_user_ns || !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&out, argp, sizeof(out)))
+		return -EFAULT;
+	if (out.version != FUSE_REQUEST_CRED_VERSION || out.flags ||
+	    out.semantics || out.group_count > NGROUPS_MAX ||
+	    (!out.groups && out.group_count))
+		return -EINVAL;
+	capacity = out.group_count;
+	out.group_count = 0;
+	out.fsuid = out.fsgid = FUSE_INVALID_UIDGID;
+	out.state = FUSE_REQUEST_CRED_NONE;
+	out.cap_effective = 0;
+	out.cap_valid = 0;
+
+	fpq = &fud->pq;
+	spin_lock(&fpq->lock);
+	req = fpq->connected ? fuse_request_find(fpq, out.unique) : NULL;
+	if (!req || !test_bit(FR_SENT, &req->flags) ||
+	    test_bit(FR_FINISHED, &req->flags) ||
+	    test_bit(FR_ABORTED, &req->flags)) {
+		err = -ENOENT;
+	} else if (req->request_cred_error) {
+		err = req->request_cred_error;
+	} else if (req->request_cred) {
+		cred = get_cred(req->request_cred);
+		out.semantics = req->request_semantics;
+	}
+	spin_unlock(&fpq->lock);
+	if (err)
+		return err;
+	if (!cred)
+		goto copy_header;
+
+	count = cred->group_info->ngroups;
+	if (count > NGROUPS_MAX || !uid_valid(cred->fsuid) ||
+	    !gid_valid(cred->fsgid)) {
+		err = -EOVERFLOW;
+		goto out;
+	}
+	/* Never munge an unmapped ID to overflowuid/overflowgid. */
+	for (n = 0; n < count; n++) {
+		if (!gid_valid(cred->group_info->gid[n])) {
+			err = -EOVERFLOW;
+			goto out;
+		}
+	}
+	out.fsuid = from_kuid(&init_user_ns, cred->fsuid);
+	out.fsgid = from_kgid(&init_user_ns, cred->fsgid);
+	out.group_count = count;
+	out.state = FUSE_REQUEST_CRED_PRESENT;
+	out.cap_effective = cred->cap_effective.val;
+	out.cap_valid = CAP_VALID_MASK;
+	if (out.groups) {
+		if (capacity < count) {
+			err = -ENOSPC;
+			goto copy_header;
+		}
+		if (count) {
+			groups = kvmalloc_array(count, sizeof(*groups), GFP_KERNEL);
+			if (!groups) {
+				err = -ENOMEM;
+				goto out;
+			}
+			for (n = 0; n < count; n++)
+				groups[n] = from_kgid(&init_user_ns,
+						      cred->group_info->gid[n]);
+			if (copy_to_user(u64_to_user_ptr(out.groups), groups,
+					 count * sizeof(*groups))) {
+				err = -EFAULT;
+				goto out;
+			}
+		}
+	}
+copy_header:
+	if (copy_to_user(argp, &out, sizeof(out)))
+		err = -EFAULT;
+out:
+	kvfree(groups);
+	if (cred)
+		put_cred(cred);
+	return err;
+}
+
+/* The session FD is a trusted-server capability, NOT proof of remote origin.
+ * Its opener's credentials are never used to authorize an operation. The
+ * authenticated storage worker installs the full captured identity first.
+ */
+static long fuse_storage_apply_attr(void __user *argp)
+{
+	struct fuse_storage_attr in;
+	struct iattr attr = {};
+	struct file *target;
+	struct inode *inode;
+	struct fd pin;
+	bool write_access = false, retained_write;
+	u32 v;
+	u64 s;
+	int err;
+
+	if (current_user_ns() != &init_user_ns)
+		return -EOPNOTSUPP;
+	if (copy_from_user(&in, argp, sizeof(in)))
+		return -EFAULT;
+	v = in.valid;
+	s = in.semantics;
+	if (in.version != FUSE_STORAGE_VERSION || in.flags || in.reserved ||
+	    in.reserved2[0] || in.reserved2[1] || (v & ~FUSE_STORAGE_ATTR_MASK) ||
+	    !(s & FUSE_REQUEST_META_VALID) || (s & ~FUSE_REQUEST_META_MASK) ||
+	    (in.mode & ~07777U) || (!(v & FUSE_STORAGE_ATTR_MODE) && in.mode) ||
+	    (!(v & FUSE_STORAGE_ATTR_UID) && in.uid) ||
+	    (!(v & FUSE_STORAGE_ATTR_GID) && in.gid) ||
+	    (!(v & FUSE_STORAGE_ATTR_SIZE) && in.size) || in.size < 0 ||
+	    (!(v & FUSE_STORAGE_ATTR_ATIME) && (in.atime || in.atime_nsec)) ||
+	    (!(v & FUSE_STORAGE_ATTR_MTIME) && (in.mtime || in.mtime_nsec)) ||
+	    in.atime_nsec >= NSEC_PER_SEC || in.mtime_nsec >= NSEC_PER_SEC ||
+	    ((v & FUSE_STORAGE_ATTR_ATIME_NOW) && !(v & FUSE_STORAGE_ATTR_ATIME)) ||
+	    ((v & FUSE_STORAGE_ATTR_MTIME_NOW) && !(v & FUSE_STORAGE_ATTR_MTIME)))
+		return -EINVAL;
+	/* notify_change BUGs on MODE plus KILL_S*ID. FORCE must never bypass
+	 * ownership checks for chmod/chown or explicit timestamps.
+	 */
+	if (((s & (FUSE_REQUEST_META_KILL_SUID | FUSE_REQUEST_META_KILL_SGID)) &&
+	     (v & FUSE_STORAGE_ATTR_MODE)) ||
+	    ((s & FUSE_REQUEST_META_FORCE) &&
+	     ((v & (FUSE_STORAGE_ATTR_MODE | FUSE_STORAGE_ATTR_UID | FUSE_STORAGE_ATTR_GID)) ||
+	      (s & (FUSE_REQUEST_META_TIMES_SET | FUSE_REQUEST_META_TOUCH)) ||
+	      ((v & FUSE_STORAGE_ATTR_ATIME) && !(v & FUSE_STORAGE_ATTR_ATIME_NOW)) ||
+	      ((v & FUSE_STORAGE_ATTR_MTIME) && !(v & FUSE_STORAGE_ATTR_MTIME_NOW)))) ||
+	    ((s & FUSE_REQUEST_META_OPEN) && (!(v & FUSE_STORAGE_ATTR_SIZE) || in.size)))
+		return -EINVAL;
+
+	if (v & FUSE_STORAGE_ATTR_MODE)
+		attr.ia_valid |= ATTR_MODE, attr.ia_mode = in.mode;
+	if (v & FUSE_STORAGE_ATTR_UID) {
+		if (in.uid == (u32)-1)
+			return -EINVAL;
+		attr.ia_valid |= ATTR_UID;
+		attr.ia_vfsuid = VFSUIDT_INIT(make_kuid(&init_user_ns, in.uid));
+	}
+	if (v & FUSE_STORAGE_ATTR_GID) {
+		if (in.gid == (u32)-1)
+			return -EINVAL;
+		attr.ia_valid |= ATTR_GID;
+		attr.ia_vfsgid = VFSGIDT_INIT(make_kgid(&init_user_ns, in.gid));
+	}
+	if (v & FUSE_STORAGE_ATTR_SIZE)
+		attr.ia_valid |= ATTR_SIZE, attr.ia_size = in.size;
+	if (v & FUSE_STORAGE_ATTR_ATIME) {
+		attr.ia_valid |= ATTR_ATIME;
+		if (!(v & FUSE_STORAGE_ATTR_ATIME_NOW))
+			attr.ia_valid |= ATTR_ATIME_SET;
+		attr.ia_atime = (struct timespec64){ in.atime, in.atime_nsec };
+	}
+	if (v & FUSE_STORAGE_ATTR_MTIME) {
+		attr.ia_valid |= ATTR_MTIME;
+		if (!(v & FUSE_STORAGE_ATTR_MTIME_NOW))
+			attr.ia_valid |= ATTR_MTIME_SET;
+		attr.ia_mtime = (struct timespec64){ in.mtime, in.mtime_nsec };
+	}
+	if (s & FUSE_REQUEST_META_KILL_SUID)
+		attr.ia_valid |= ATTR_KILL_SUID;
+	if (s & FUSE_REQUEST_META_KILL_SGID)
+		attr.ia_valid |= ATTR_KILL_SGID;
+	if (s & FUSE_REQUEST_META_KILL_PRIV)
+		attr.ia_valid |= ATTR_KILL_PRIV;
+	if (s & FUSE_REQUEST_META_FORCE)
+		attr.ia_valid |= ATTR_FORCE;
+	if (s & FUSE_REQUEST_META_CTIME)
+		attr.ia_valid |= ATTR_CTIME;
+	if (s & FUSE_REQUEST_META_TIMES_SET)
+		attr.ia_valid |= ATTR_TIMES_SET;
+	if (s & FUSE_REQUEST_META_TOUCH)
+		attr.ia_valid |= ATTR_TOUCH;
+	if (s & FUSE_REQUEST_META_OPEN)
+		attr.ia_valid |= ATTR_OPEN;
+
+	/* Raw lookup retains O_PATH, including O_NOFOLLOW symlink pins. Never
+	 * reopen by name, /proc, or file handle; fd reuse is the server's lock.
+	 */
+	pin = fdget_raw(in.fd);
+	if (fd_empty(pin))
+		return -EBADF;
+	target = fd_file(pin);
+	inode = file_inode(target);
+	err = -EOPNOTSUPP;
+	if ((!S_ISREG(inode->i_mode) && !S_ISDIR(inode->i_mode) && !S_ISLNK(inode->i_mode)) ||
+	    inode->i_sb->s_magic != EXT4_SUPER_MAGIC ||
+	    strcmp(inode->i_sb->s_type->name, "ext4") ||
+	    inode->i_sb->s_user_ns != &init_user_ns ||
+	    file_mnt_idmap(target) != &nop_mnt_idmap)
+		goto out;
+	if ((v & FUSE_STORAGE_ATTR_SIZE) && !S_ISREG(inode->i_mode))
+		goto out;
+	/* chmod_common/notify_change reject symlinks even if MODE is unchanged. */
+	if ((v & FUSE_STORAGE_ATTR_MODE) && S_ISLNK(inode->i_mode))
+		goto out;
+	retained_write = (s & FUSE_REQUEST_META_FILE) &&
+			 (target->f_mode & FMODE_WRITE);
+	if (s & FUSE_REQUEST_META_FILE) {
+		attr.ia_valid |= ATTR_FILE;
+		attr.ia_file = target;
+	}
+	/* Match fs/open.c: ftruncate checks the exact file's LSM state, not
+	 * current DAC (chmod after open does not revoke that handle). Pathname
+	 * truncate instead checks CURRENT DAC, then pre-content permission.
+	 * Permission watchers may block/reenter: never hold the inode lock here.
+	 */
+	if (v & FUSE_STORAGE_ATTR_SIZE) {
+		if (retained_write) {
+			err = -EPERM;
+			if (IS_APPEND(inode))
+				goto out;
+			err = security_file_truncate(target);
+		} else {
+			err = inode_permission(&nop_mnt_idmap, inode, MAY_WRITE);
+		}
+		if (err)
+			goto out;
+		err = fsnotify_truncate_perm(&target->f_path, in.size);
+		if (err)
+			goto out;
+	} else if ((s & FUSE_REQUEST_META_FORCE) && !retained_write) {
+		/* Kill-only FORCE is a write side effect, not authority from a pin. */
+		err = inode_permission(&nop_mnt_idmap, inode, MAY_WRITE);
+		if (err)
+			goto out;
+	}
+	/* Check the exact pinned mount, including O_PATH read-only binds. */
+	err = mnt_want_write(target->f_path.mnt);
+	if (err)
+		goto out;
+	if ((v & FUSE_STORAGE_ATTR_SIZE) && !retained_write) {
+		err = -EPERM;
+		if (IS_APPEND(inode))
+			goto drop_write;
+		err = get_write_access(inode);
+		if (err)
+			goto drop_write;
+		write_access = true;
+		/* Write access must precede lease breaking, as in vfs_truncate. */
+		err = break_lease(inode, O_WRONLY);
+		if (err)
+			goto put_write;
+		err = security_path_truncate(&target->f_path);
+		if (err)
+			goto put_write;
+	}
+	err = inode_lock_killable(inode);
+	if (err)
+		goto put_write;
+	if (v & FUSE_STORAGE_ATTR_MODE)
+		attr.ia_mode |= inode->i_mode & S_IFMT;
+	err = notify_change(&nop_mnt_idmap, target->f_path.dentry, &attr, NULL);
+	inode_unlock(inode);
+put_write:
+	if (write_access)
+		put_write_access(inode);
+drop_write:
+	mnt_drop_write(target->f_path.mnt);
+out:
+	fdput(pin);
+	return err;
+}
+
+static long fuse_storage_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long arg)
+{
+	if (cmd != FUSE_STORAGE_IOC_APPLY_ATTR)
+		return -ENOTTY;
+	return fuse_storage_apply_attr((void __user *)arg);
+}
+
+static const struct file_operations fuse_storage_operations = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = fuse_storage_ioctl,
+	.compat_ioctl = compat_ptr_ioctl,
+};
+
+static long fuse_dev_ioctl_storage_session(unsigned long arg)
+{
+	/* Independent of fuse_get_dev: storage VMs need no local FUSE mount.
+	 * Check minting credentials, not /dev/fuse's potentially old f_cred.
+	 */
+	if (current_user_ns() != &init_user_ns || !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (arg)
+		return -EINVAL;
+	return anon_inode_getfd("cengine-storage", &fuse_storage_operations,
+				NULL, O_RDWR | O_CLOEXEC);
+}
+
 static long fuse_dev_ioctl(struct file *file, unsigned int cmd,
 			   unsigned long arg)
 {
@@ -2708,6 +3084,12 @@ static long fuse_dev_ioctl(struct file *file, unsigned int cmd,
 	case FUSE_DEV_IOC_SYNC_INIT:
 		return fuse_dev_ioctl_sync_init(file);
 
+	case FUSE_DEV_IOC_STORAGE_SESSION:
+		return fuse_dev_ioctl_storage_session(arg);
+
+	case FUSE_DEV_IOC_REQUEST_CRED:
+		return fuse_dev_ioctl_request_cred(file, argp);
+
 	default:
 		return -ENOTTY;
 	}
